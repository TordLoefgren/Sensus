<UserControl
    x:Class="Sensus.Views.ViewportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sensus.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="ViewportHost"
        Margin="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{StaticResource AppSurfaceBrush}"
        ClipToBounds="True">

        <Canvas x:Name="GridLayer" IsHitTestVisible="False" />

        <Canvas x:Name="ObjectLayer" />

        <Canvas x:Name="GizmoLayer" IsHitTestVisible="False" />
    </Grid>

</UserControl>
