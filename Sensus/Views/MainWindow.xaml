<Window
    x:Class="Sensus.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sensus.Views.Controls"
    xmlns:converters="clr-namespace:Sensus.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:Sensus.Views"
    Title="Sensus"
    Width="1400"
    Height="850"
    MinWidth="1200"
    MinHeight="650"
    Background="{StaticResource ShellBrush}"
    FontSize="13"
    Foreground="{StaticResource TextBrush}"
    Icon="/Resources/Assets/SensusGlyph.ico"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="36"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border
        x:Name="WindowBorder"
        Background="{StaticResource ShellBrush}"
        BorderBrush="{StaticResource WindowBorderBrush}"
        BorderThickness="1">

        <Grid x:Name="WindowLayout" Background="{StaticResource ShellBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>


            <!--  ==================== Window chrome ====================  -->

            <Border
                Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Control
                            Width="17"
                            Height="17"
                            Margin="0,1,8,0"
                            Style="{StaticResource SensusGlyphStyle}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Sensus" />

                    </StackPanel>

                    <StackPanel Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal">

                        <Button Click="MinimizeButton_Click" Style="{StaticResource MinimizeButtonStyle}" />

                        <Button Click="MaximizeRestoreButton_Click" Style="{StaticResource MaximizeRestoreButtonStyle}" />

                        <Button Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}" />

                    </StackPanel>

                </Grid>

            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Workspace}" />

            <ContentControl Grid.Row="2" Content="{Binding Workspace.StatusBar}" />

        </Grid>

    </Border>

</Window>
