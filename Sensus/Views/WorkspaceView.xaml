<UserControl
    x:Class="Sensus.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sensus.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--  ==================== Workspace ====================  -->

    <Grid Grid.Row="1" Background="{StaticResource WorkspaceBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="250" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="8*" MinWidth="400" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="3*" MinWidth="250" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!--  Both panels must use star sizing so the splitter constrains their combined height.  -->
            <RowDefinition Height="3*" MinHeight="150" />
            <RowDefinition Height="10" />
            <RowDefinition Height="2*" MinHeight="240" />
        </Grid.RowDefinitions>

        <!--  ==================== Scanner ====================  -->

        <Border
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="10,10,0,10"
            Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Scanner}" />

        </Border>

        <!--  ==================== Scan ====================  -->

        <Border Grid.Column="2" Margin="0,10,0,0" Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Scan}" />

        </Border>

        <!--  ==================== Timeline ====================  -->

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Margin="0,0,0,10"
            Style="{StaticResource WorkspacePanelBorderStyle}">

            <local:TimelineView ScannerConfiguration="{Binding State.Session.Configuration}" ScannerDefinition="{Binding State.Session.Definition}" Session="{Binding State.Session}" />

        </Border>

        <!--  ==================== Inspector ====================  -->

        <Border
            Grid.RowSpan="3"
            Grid.Column="4"
            Margin="0,10,10,10"
            Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Inspector}" />

        </Border>

        <!--  ==================== Resize handles ====================  -->

        <GridSplitter
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="0,10"
            AutomationProperties.Name="Resize scanner and scan"
            ResizeDirection="Columns"
            Style="{StaticResource WorkspaceGridSplitterStyle}" />

        <GridSplitter
            Grid.Row="1"
            Grid.Column="2"
            AutomationProperties.Name="Resize scan and timeline"
            ResizeDirection="Rows"
            Style="{StaticResource WorkspaceGridSplitterStyle}" />

        <GridSplitter
            Grid.RowSpan="3"
            Grid.Column="3"
            Margin="0,10"
            AutomationProperties.Name="Resize scan and inspector"
            ResizeDirection="Columns"
            Style="{StaticResource WorkspaceGridSplitterStyle}" />

    </Grid>

</UserControl>
