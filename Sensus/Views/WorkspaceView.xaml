<UserControl
    x:Class="Sensus.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sensus.Views.Controls"
    xmlns:converters="clr-namespace:Sensus.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sensus.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <!--  ==================== Workspace ====================  -->

    <Grid Grid.Row="1" Background="{StaticResource WorkspaceBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>


        <!--  ==================== Scanner ====================  -->

        <Border Grid.Column="0" Margin="10,10,0,10" Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Scanner}" />

        </Border>


        <!--  ==================== Viewport ====================  -->

        <Border Grid.Column="1" Margin="10" Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Viewport}" />

        </Border>


        <!--  ==================== Inspector ====================  -->

        <Border Grid.Column="2" Margin="0,10,10,10" Style="{StaticResource WorkspacePanelBorderStyle}">

            <ContentControl Content="{Binding Inspector}" />

        </Border>

    </Grid>

</UserControl>
